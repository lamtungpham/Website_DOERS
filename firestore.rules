rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidDiaryEntry(data) {
      return data.keys().hasAll(['title', 'content', 'authorId', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.content is string && data.content.size() > 0 && data.content.size() <= 1000000
        && data.authorId == request.auth.uid
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && (data.get('thumbnailUrl', '') is string && data.get('thumbnailUrl', '').size() <= 2000000)
        && (data.get('videoUrl', '') is string && data.get('videoUrl', '').size() <= 2000)
        && (data.get('tag', '') is string && data.get('tag', '').size() <= 50)
        && (data.get('day', '') is string && data.get('day', '').size() <= 50)
        && (data.get('isPinned', false) is bool);
    }

    function isValidDiaryUpdate(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.content is string && data.content.size() > 0 && data.content.size() <= 1000000
        && data.authorId == existing().authorId
        && (data.get('thumbnailUrl', '') is string && data.get('thumbnailUrl', '').size() <= 2000000)
        && (data.get('videoUrl', '') is string && data.get('videoUrl', '').size() <= 2000)
        && (data.get('tag', '') is string && data.get('tag', '').size() <= 50)
        && (data.get('day', '') is string && data.get('day', '').size() <= 50)
        && (data.get('isPinned', false) is bool)
        && data.createdAt == existing().createdAt;
    }

    match /diaries/{diaryId} {
      allow list: if true; // Public read
      allow get: if isValidId(diaryId); // Public read
      
      allow create: if isSignedIn() 
        && isValidId(diaryId)
        && isValidDiaryEntry(incoming())
        && incoming().keys().hasOnly(['title', 'content', 'thumbnailUrl', 'videoUrl', 'tag', 'day', 'authorId', 'createdAt', 'updatedAt', 'isPinned']);

      allow update: if isSignedIn()
        && isValidId(diaryId)
        && isValidDiaryUpdate(incoming())
        && existing().authorId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'thumbnailUrl', 'videoUrl', 'tag', 'day', 'updatedAt', 'isPinned']);

      allow delete: if isSignedIn() 
        && isValidId(diaryId)
        && existing().authorId == request.auth.uid;
    }
  }
}
